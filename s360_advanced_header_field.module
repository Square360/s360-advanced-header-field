<?php

/**
 * @file
 * s360_advanced_header_field.module
 */

use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\Core\Template\Attribute;

/**
 * Implements hook_help().
 */
function s360_advanced_header_field_help($route_name, RouteMatchInterface $route_match) {
  switch ($route_name) {
    case 'help.page.s360_advanced_header_field':
      $output = '';

      $output .= '<h3>' . t('About') . '</h3>';
      $output .= '<p>' . t('This module provides a configurable header field with optional text-as-link.') . '</p>';

      $output .= '<p>&nbsp;</p>';

      $output .= '<h3>' . t('Classes') . '</h3>';
      $output .= t('<p><code>[base-class]</code> which defaults to <strong><code>advanced-header-field</code></strong> can be overwritten in the hook <strong><code>THEME_preprocess_advanced_header_field</code></strong>.');
      $output .= '<p>' . t('All classes are added as "modifers" to the top level element.') . '</p>';
      $output .= '<p>' . t('NOTE: There are no base styles provided by this module, all styles must be provided from your Drupal theme.') . '</p>';

      $output .= '<h4>' . t('Built-in Classes') . '</h4>';

      $output .= '<h5>' . t('Modifiers') . '</h5>';
      $output .= '<ul>';
      $output .= '<li>.[base-class]--size-h1</li>';
      $output .= '<li>.[base-class]--size-h2</li>';
      $output .= '<li>.[base-class]--size-h3</li>';
      $output .= '<li>.[base-class]--size-h4</li>';
      $output .= '<li>.[base-class]--size-h5</li>';
      $output .= '<li>.[base-class]--size-h6</li>';
      $output .= '</ul>';

      $output .= '<h5>' . t('Elements') . '</h5>';
      $output .= '<ul>';
      $output .= '<li>.[base-class]__heading</li>';
      $output .= '<li>.[base-class]__subtitle</li>';
      $output .= '</ul>';

      $output .= '<h4>' . t('Custom Classes') . '</h4>';
      $output .= '<p>' . t('"Field settings: Custom Styles" will be rendered as <code>.[base-class]--style-[CUSTOM_STYLE_KEY]</code>.') . '</p>';

      $output .= '<p>&nbsp;</p>';

      $output .= '<h3>' . t('Formatters') . '</h3>';

      $output .= '<h4>' . t('HTML Markup') . '</h4>';
      $output .= '<p>' . t('This is the default formatter for the field. It will wrap the all the elements in HTML elements.') . '</p>';
      $output .= '<p>' . t('You can select what HTML tag the top level element gets; Semantic (header) or Generic (div).') . '</p>';

      $output .= '<h4>' . t('Plain text') . '</h4>';
      $output .= '<p>' . t('This formatter will display the header title and heading tag only with no HTML markup. This formatter will typical be used in previews for content editors.') . '</p>';

      return $output;
  }
}

/**
 * Implements hook_page_attachments_alter().
 */
function s360_advanced_header_field_page_attachments_alter(array &$attachments) {
  // Attach the "admin" library only when the route IS the admin.
  if (\Drupal::service('router.admin_context')->isAdminRoute()) {
    $attachments['#attached']['library'][] = 's360_advanced_header_field/s360-advanced-header-field';
  }
}

function s360_advanced_header_field_theme() {
  $items = [];

  $items['advanced_header_field'] = [
    'render element' => 'elements'
  ];

  return $items;
}

/**
 * Prepares variables for advanced-header-field template.
 */
function template_preprocess_advanced_header_field(&$variables) {
  $variables['tag'] = $variables['elements']['#item']->options['tag'];
  $variables['attributes'] = new Attribute([
    'class' => 'advanced-header-field',
  ]);

  $variables['heading'] = [];
  $variables['heading']['tag'] = $variables['elements']['#item']->options['heading_tag'];
  $variables['heading']['attributes'] = new Attribute([]);
  $variables['heading']['text'] = $variables['elements']['#item']->heading_text;

  $variables['subtitle'] = [];
  $variables['subtitle']['attributes'] = new Attribute([]);
  $variables['subtitle']['text'] = $variables['elements']['#item']->subtitle;
}
